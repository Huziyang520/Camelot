{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "Shared library: configuration screens, join notices, networking and GUI helpers.",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Huziyang520/Camelot",
        "issues": "https://github.com/Huziyang520/Camelot/issues"
    },
    "license": "${license}",
    "icon": "assets/camelot/textures/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.camelot.fabric.CamelotFabric"
        ],
        "client": [
            "com.camelot.fabric.CamelotFabricClient"
        ]
    },
    "depends": {
        "fabricloader": ">=0.14",
        "minecraft": "*",
        "java": ">=${java_version}"
    }
}
